{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lanzar WV.js",
            "type": "shell",
            "command": "${workspaceFolder}/Calculator.js.exe",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": {
                "owner": "wvjs-launcher",
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "WV.js listo para depurar en el puerto"
                }
            }
        },
        {
            "label": "Cerrar WV.js",
            "type": "shell",
            "command": "taskkill /IM Calculator.js.exe /F",
            "presentation": {
                "reveal": "never",
                "close": true
            },
            "problemMatcher": []
        }
    ]
}